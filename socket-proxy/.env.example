# First running this in shell: docker network create socket-proxy-net
# Host interface IP binding (e.g., 10.40.0.10, 10.80.0.5, 100.64.0.10)
HOST_IP=127.0.0.1

# =======================================================
# DO NOT EDIT THIS (Required Core & API Health Basics)
# =======================================================
INFO=1             # Required for HA/Homarr to fetch Docker daemon details
VERSION=1          # Required for API version negotiation
PING=1             # Required for proxy & service health checks
EVENTS=1           # Required for live event streaming to dashboards

# =======================================================
# EDIT THIS (Customize based on Read-Only vs Control Node)
# =======================================================
# Container Read Access
CONTAINERS=1       # Set 1 to list/view containers, 0 to hide completely
NETWORKS=1         # Set 1 to allow network inspection, 0 to disable
# Container Power Controls (Write Access)
POST=0             # Master switch: Set 1 for write API actions, 0 for Read-Only
ALLOW_START=0      # Set 1 to allow starting containers (requires POST=1)
ALLOW_STOP=0       # Set 1 to allow stopping containers (requires POST=1)
ALLOW_RESTARTS=0   # Set 1 to allow restarting containers (requires POST=1)
# High-Risk Security Blocks (Keep disabled unless strictly required)
BUILD=0            # Do not allow building images
EXEC=0             # Do not allow terminal execution inside containers
VOLUMES=0          # Do not allow mounting/deleting host volumes
SYSTEM=0           # Do not allow host prune/system commands
